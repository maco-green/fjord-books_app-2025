<div id="<%= dom_id comment %>">

  <p>
    <strong><%= t('activerecord.attributes.comment.user') %>：</strong>
    <%= display_user_name(comment.user) %>
    <strong><%= t('activerecord.attributes.comment.time') %>：</strong>
    <%= l comment.created_at, format: :long %>
    <strong><%= t('activerecord.attributes.comment.body') %>：</strong>
    <%= comment.body %>
  </p>

</div>

<% if comment.user == current_user %>
  <nav class="page-nav">
    <%= link_to t('views.common.edit', name: Comment.model_name.human.downcase), edit_polymorphic_path([comment.commentable, comment]) %>
    <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), polymorphic_path([comment.commentable, comment]), method: :delete %>
  </nav>
<% end %>
