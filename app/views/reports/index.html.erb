<% content_for :title, "Reports" %>

<h1><%= t('.title') %></h1>

<div id="reports">
  <% @reports.each do |report| %>
    <%= render report %>
    <p>
      <%= link_to t('views.common.show', name: Report.model_name.human.downcase), report %>
    </p>
  <% end %>
</div>

<%= link_to t('views.common.new', name: Report.model_name.human.downcase), new_report_path %>
